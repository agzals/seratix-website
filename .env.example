# Salin menjadi .env lalu isi data asli (build ulang setiap kali diubah).
# Variabel berawalan VITE_ ikut tertanam di kode browser: JANGAN taruh rahasia di sini.

# Nomor WhatsApp format 62xxxx (tanpa + dan tanpa 0 di depan)
VITE_WHATSAPP_NUMBER=6281234567890
VITE_CONTACT_EMAIL=hello@seratix.com

# Alamat website ini (dipakai untuk gambar pratinjau saat link dibagikan, mis. https://seratix.com)
VITE_SITE_URL=https://seratix.com

# Alamat aplikasi Seratix Hound (mis. https://hound.seratix.com atau https://seratix-hound.vercel.app).
# KOSONGKAN bila Hound belum online: website otomatis menampilkan "Minta akses beta" dan tidak ada link mati.
VITE_HOUND_URL=
